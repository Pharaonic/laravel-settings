{
  "name": "pharaonic/laravel-settings",
  "description": "Typed, scoped application settings for Laravel: an Eloquent Setting model for global, named and per-model preferences, with explicit fallback, optional definitions and validation.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "settings",
    "preferences",
    "eloquent",
    "typed settings",
    "multi-tenant",
    "pharaonic"
  ],
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/settings",
    "issues": "https://github.com/Pharaonic/laravel-settings/issues",
    "source": "https://github.com/Pharaonic/laravel-settings"
  },
  "require": {
    "php": ">=8.1 <8.4",
    "illuminate/console": "^10.0",
    "illuminate/container": "^10.0",
    "illuminate/contracts": "^10.0",
    "illuminate/database": "^10.0",
    "illuminate/support": "^10.0",
    "illuminate/validation": "^10.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^8.0",
    "pestphp/pest": "^1.23",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6.33"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\Settings\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\Settings\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\Settings\\SettingsServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 10; the application chooses the framework release."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
